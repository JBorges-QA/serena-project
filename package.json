{
  "name": "clinica-massoterapia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "dev:whatsapp": "cross-env NEXT_PUBLIC_BOOKING_MODE=whatsapp next dev -p 3001",
    "dev:all": "concurrently -n chat,whatsapp -c green,cyan \"npm run dev\" \"npm run dev:whatsapp\"",
    "build:whatsapp": "cross-env NEXT_PUBLIC_BOOKING_MODE=whatsapp next build",
    "start:whatsapp": "cross-env NEXT_PUBLIC_BOOKING_MODE=whatsapp next start -p 3001"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  }
}
